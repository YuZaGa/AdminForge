  },
  "dependencies": {
    "@adminforge/core": "workspace:*",
    "next": "^15.0.0",
    "next-auth": "^5.0.0-beta.25"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0"
  }
